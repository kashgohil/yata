# 30 cells: three columns with two 2-cell gaps leave 26 cells. The fixed
# first track is 1; 1fr and 2fr receive 8 and 17 after integer distribution.
# The first cell wraps to three rows; the third spans the last two tracks.
<html>  x=0 y=0 w=30 h=5
  <body>  x=0 y=0 w=30 h=5
    <div.grid> grid cols=[1, 8, 17] rows=[3, 1]  x=0 y=0 w=30 h=5
      <div>  x=0 y=0 w=1 h=3
        anonymous  x=0 y=0 w=1 h=3
          line  x=0 y=0 w=1 h=1
            #text "o"  x=0 y=0 w=1 h=1
          line  x=0 y=1 w=1 h=1
            #text "n"  x=0 y=1 w=1 h=1
          line  x=0 y=2 w=1 h=1
            #text "e"  x=0 y=2 w=1 h=1
      <div>  x=3 y=0 w=8 h=1
        anonymous  x=3 y=0 w=8 h=1
          line  x=3 y=0 w=8 h=1
            #text "two"  x=3 y=0 w=3 h=1
      <div.wide>  x=3 y=4 w=27 h=1
        anonymous  x=3 y=4 w=27 h=1
          line  x=3 y=4 w=27 h=1
            #text "wide"  x=3 y=4 w=4 h=1
