# SPEC GOLDEN — hand-written from CSS 2.1 §10.4 (width) and §10.7 (height),
# never regenerated. The order is the rule: tentative size, clamp by max,
# then clamp by min — so min wins when the two conflict.
#
# .wide   width 80px = 10 cells   -> tentative 10
#         max-width 160px = 20    -> min(10, 20) = 10
#         min-width 240px = 30    -> max(10, 30) = 30   <- min wins
#
# .tall   width auto              -> fills 40 cells
#         content is one line     -> tentative height 1
#         max-height 32px = 2     -> min(1, 2) = 1
#         min-height 80px = 5     -> max(1, 5) = 5      <- min wins
#         the anonymous block inside keeps its own 1-line height: the clamp
#         sizes the block, it does not stretch the content
#
# .capped width 320px = 40 cells  -> tentative 40
#         max-width 80px = 10     -> min(40, 10) = 10   <- max alone still bites
#
# Stacking, no margins anywhere: y = 0, then 1, then 1 + 5 = 6. Page is 7 rows.
<html>  x=0 y=0 w=40 h=7
  <body>  x=0 y=0 w=40 h=7
    <div.wide>  x=0 y=0 w=30 h=1
      anonymous  x=0 y=0 w=30 h=1
        line  x=0 y=0 w=30 h=1
          #text "wide"  x=0 y=0 w=4 h=1
    <div.tall>  x=0 y=1 w=40 h=5
      anonymous  x=0 y=1 w=40 h=1
        line  x=0 y=1 w=40 h=1
          #text "tall"  x=0 y=1 w=4 h=1
    <div.capped>  x=0 y=6 w=10 h=1
      anonymous  x=0 y=6 w=10 h=1
        line  x=0 y=6 w=10 h=1
          #text "capped"  x=0 y=6 w=6 h=1
